# Texto por defecto
* text=auto

# Fuerza LF en cosas de Linux
*.sh         text eol=lf
Dockerfile   text eol=lf
*.py         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Windows scripts (si quieres CRLF localmente en PowerShell)
*.ps1        text eol=crlf
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Front-end (solo texto; EOL lo decide la regla general)
*.js         text
*.ts         text
*.css        text
*.html       text
*.json       text
*.md         text

# Binarios: sin conversión de EOL
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.mp3  binary
*.m4a  binary
*.wav  binary
*.ogg  binary
*.flac binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.ico  binary
*.zip  binary
