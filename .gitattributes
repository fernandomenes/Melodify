# Por defecto: NO tocar EOL (evita que Git “toque” binarios)
* -text

# Normaliza sólo archivos de texto comunes a LF
*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# Redundante pero explícito para media
*.mp3  -text binary
*.m4a  -text binary
*.wav  -text binary
*.ogg  -text binary
*.flac -text binary
*.jpg  -text binary
*.jpeg -text binary
*.png  -text binary
*.webp -text binary

# Semilla completa siempre binaria
seeds/** -text binary
